    "afinar": "tsx scripts/afinar-fotos.ts",
    "verificar": "tsx scripts/verificar.ts",
    "limpiar:peso": "tsx scripts/limpiar-peso.ts",
    "comprimir": "tsx scripts/comprimir-mas.ts",
