{
  "name": "shukmotor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "snapshot:precios": "tsx scripts/snapshot-precios.ts",
    "diff:precios": "tsx scripts/diff-precios.ts",
    "historial:precios": "tsx scripts/historial-precios.ts",
    "radar": "tsx scripts/radar.ts",
    "fetch:videos": "tsx scripts/videos.ts",
