    "check:data": "tsx scripts/check-data.ts",
    "fetch:fotos": "tsx scripts/fetch-fotos.ts",
    "fetch:novedades": "tsx scripts/fetch-novedades.ts",
    "fetch:logos": "tsx scripts/fetch-logos.ts",
    "fetch:fotos-wiki": "tsx scripts/fetch-fotos-wiki.ts",
    "merge:fotos": "tsx scripts/merge-fotos.ts",
